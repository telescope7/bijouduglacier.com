{{ ansible_managed | comment }}
# Hand edits to this file are overwritten on the next deploy. Change
# deploy/templates/ instead.
#
# On the first run there is no certificate yet, so this is HTTP only and just
# serves the site. Once certbot has issued one, the playbook re-renders this
# file with the HTTPS blocks below and reloads.

server {
    listen 80;
    listen [::]:80;
    server_name {{ domain }} www.{{ domain }};

    # Renewals are fetched over plain HTTP, so this stays reachable even after
    # everything else on port 80 is redirected away.
    location ^~ /.well-known/acme-challenge/ {
        root {{ acme_root }};
        default_type "text/plain";
    }
{% if tls %}

    location / {
        return 301 https://{{ domain }}$request_uri;
    }
}

# www exists so that people who type it get somewhere, but the canonical URLs
# on every page are the bare domain, so it only ever redirects.
# =============================================================================
# HTTP/2 IS DISABLED ON PURPOSE — 19 November 2026
#
# CVE-2026-123007 and CVE-2026-123633 ("NGINX2Root") are heap overflows in
# nginx's HTTP/2 flow control. Unauthenticated, remote, no user interaction,
# and a public proof of concept. CVSS 4.0 9.2.
#
# Fixed upstream in nginx 1.30.7 / 1.31.9, but Canonical's tracker still
# listed 24.04 as Vulnerable when this was written, so `apt upgrade` was not
# yet a fix. Turning HTTP/2 off removes the attack surface entirely: the
# vulnerable code is never reached over HTTP/1.1.
#
# Cost: no request multiplexing. On a static site of this size that is a
# small latency difference, not a functional change. TLS is unaffected.
#
# TO TURN IT BACK ON once the server is patched, add ` http2` back to the
# four listen lines below, then:
#     ssh $SERVER 'nginx -v'          # must be >= 1.30.7, or the Ubuntu
#                                     # package that backports the fix
#     ansible-playbook -i inventory.ini deploy.yml
#
#   https://ubuntu.com/security/CVE-2026-123007
# =============================================================================

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name www.{{ domain }};

    ssl_certificate     /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ domain }}/privkey.pem;

    return 301 https://{{ domain }}$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ domain }};

    ssl_certificate         /etc/letsencrypt/live/{{ domain }}/fullchain.pem;
    ssl_certificate_key     /etc/letsencrypt/live/{{ domain }}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/{{ domain }}/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;

    # Tells browsers to refuse plain HTTP for this domain for a year. Read the
    # note in README.md before you point this domain anywhere else.
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    include snippets/{{ domain }}.conf;
}
{% else %}
    include snippets/{{ domain }}.conf;
}
{% endif %}
